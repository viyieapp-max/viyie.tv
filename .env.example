# TMDB API Key for fetching movie/TV data by IMDb ID
TMDB_API_KEY=

# Google Drive API Key for streaming large Google Drive files in Custom Player
VITE_GOOGLE_DRIVE_API_KEY=

# Optional: Custom domain for Firebase Authentication popup/redirect (to hide default firebaseapp.com domain)
VITE_FIREBASE_AUTH_DOMAIN=

# Admin Login Credentials
ADMIN_USER=
ADMIN_PASS=

# Google OAuth Credentials for Drive Backup & Restore
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=

# Owner Contact Email
OWNER_EMAIL=

